@model Container
@{
    ViewData["Title"] = "Editar Container";
}

<div class="form-card card shadow-sm mx-auto">
    <div class="card-header bg-warning"><h1 class="h4 mb-0">Editar Container</h1></div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Numero" class="form-label fw-semibold"></label>
                <input asp-for="Numero" class="form-control text-uppercase" maxlength="11" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tipo" class="form-label fw-semibold"></label>
                <select asp-for="Tipo" class="form-select">
                    <option value="Dry">Dry</option><option value="Reefer">Reefer</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tamanho" class="form-label fw-semibold"></label>
                <select asp-for="Tamanho" class="form-select">
                    <option value="20">20 pés</option><option value="40">40 pés</option>
                </select>
                <span asp-validation-for="Tamanho" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BlId" class="form-label fw-semibold"></label>
                <select asp-for="BlId" asp-items="ViewBag.BlId" class="form-select"></select>
                <span asp-validation-for="BlId" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Atualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
