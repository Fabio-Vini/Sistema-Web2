@model Container
@{
    ViewData["Title"] = "Excluir Container";
}

<div class="form-card card border-danger shadow-sm mx-auto">
    <div class="card-header bg-danger text-white"><h1 class="h4 mb-0">Confirmar exclusão</h1></div>
    <div class="card-body">
        <p>Tem certeza de que deseja excluir este Container?</p>
        <dl class="row">
            <dt class="col-sm-4">Número</dt><dd class="col-sm-8">@Model.Numero</dd>
            <dt class="col-sm-4">Tipo</dt><dd class="col-sm-8">@Model.Tipo</dd>
            <dt class="col-sm-4">Tamanho</dt><dd class="col-sm-8">@Model.Tamanho pés</dd>
            <dt class="col-sm-4">BL</dt><dd class="col-sm-8">@(Model.Bl?.Numero)</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-between">
            <input type="hidden" asp-for="Id" />
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-danger">Excluir</button>
        </form>
    </div>
</div>
