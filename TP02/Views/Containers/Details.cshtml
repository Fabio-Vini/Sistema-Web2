@model Container
@{
    ViewData["Title"] = "Detalhes do Container";
}

<div class="form-card card shadow-sm mx-auto">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0">Container @Model.Numero</h1>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-light">Editar</a>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Tipo</dt><dd class="col-sm-8">@Model.Tipo</dd>
            <dt class="col-sm-4">Tamanho</dt><dd class="col-sm-8">@Model.Tamanho pés</dd>
            <dt class="col-sm-4">BL vinculado</dt><dd class="col-sm-8">@(Model.Bl?.Numero)</dd>
            <dt class="col-sm-4">Consignee</dt><dd class="col-sm-8">@(Model.Bl?.Consignee)</dd>
            <dt class="col-sm-4">Navio</dt><dd class="col-sm-8">@(Model.Bl?.Navio)</dd>
        </dl>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</div>
