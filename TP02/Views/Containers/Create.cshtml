@model Container
@{
    ViewData["Title"] = "Cadastrar Container";
    var possuiBls = ViewData["PossuiBls"] as bool? == true;
}

<div class="form-card card shadow-sm mx-auto">
    <div class="card-header bg-success text-white"><h1 class="h4 mb-0">Cadastrar novo Container</h1></div>
    <div class="card-body">
        @if (!possuiBls)
        {
            <div class="alert alert-warning">
                Cadastre um BL antes de cadastrar um Container.
                <a asp-controller="Bls" asp-action="Create" class="alert-link">Cadastrar BL</a>
            </div>
        }
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Numero" class="form-label fw-semibold"></label>
                <input asp-for="Numero" class="form-control text-uppercase" maxlength="11" placeholder="Ex.: ABCD1234567" />
                <span asp-validation-for="Numero" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tipo" class="form-label fw-semibold"></label>
                <select asp-for="Tipo" class="form-select">
                    <option value="">-- Selecione --</option>
                    <option value="Dry">Dry</option>
                    <option value="Reefer">Reefer</option>
                </select>
                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Tamanho" class="form-label fw-semibold"></label>
                <select asp-for="Tamanho" class="form-select">
                    <option value="">-- Selecione --</option>
                    <option value="20">20 pés</option>
                    <option value="40">40 pés</option>
                </select>
                <span asp-validation-for="Tamanho" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BlId" class="form-label fw-semibold"></label>
                <select asp-for="BlId" asp-items="ViewBag.BlId" class="form-select">
                    <option value="">-- Selecione o BL --</option>
                </select>
                <span asp-validation-for="BlId" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                @if (possuiBls)
                {
                    <button type="submit" class="btn btn-success">Salvar Container</button>
                }
                else
                {
                    <button type="button" class="btn btn-success" disabled>Salvar Container</button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
