@model IEnumerable<Bl>
@{
    ViewData["Title"] = "BLs";
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">BLs cadastrados</h1>
        <p class="text-muted mb-0">Gerencie os documentos de transporte.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Cadastrar BL</a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle bg-white mb-0">
        <thead class="table-dark">
            <tr>
                <th>Número do BL</th>
                <th>Consignee</th>
                <th>Navio</th>
                <th>Containers</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Numero</td>
                    <td>@item.Consignee</td>
                    <td>@item.Navio</td>
                    <td><span class="badge bg-secondary">@item.Containers.Count</span></td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Nenhum BL cadastrado.</td></tr>
        }
        </tbody>
    </table>
</div>
