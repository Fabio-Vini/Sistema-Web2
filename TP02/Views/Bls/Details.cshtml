@model Bl
@{
    ViewData["Title"] = "Detalhes do BL";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h1 class="h4 mb-0">BL @Model.Numero</h1>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-light">Editar</a>
    </div>
    <div class="card-body">
        <dl class="row mb-4">
            <dt class="col-sm-3">Consignee</dt><dd class="col-sm-9">@Model.Consignee</dd>
            <dt class="col-sm-3">Navio</dt><dd class="col-sm-9">@Model.Navio</dd>
        </dl>

        <h2 class="h5">Containers vinculados</h2>
        @if (Model.Containers.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead><tr><th>Número</th><th>Tipo</th><th>Tamanho</th></tr></thead>
                    <tbody>
                    @foreach (var container in Model.Containers.OrderBy(item => item.Numero))
                    {
                        <tr><td>@container.Numero</td><td>@container.Tipo</td><td>@container.Tamanho pés</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Nenhum container vinculado a este BL.</p>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</div>
