@model IEnumerable<Bl>
@{
    ViewData["Title"] = "Relatório BL/Container";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h2 mb-1">Relatório BL/Container</h1>
        <p class="text-muted mb-0">Relação completa entre os BLs e seus containers.</p>
    </div>
    <button type="button" class="btn btn-outline-primary no-print" onclick="window.print()">Imprimir</button>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-bordered table-striped align-middle bg-white mb-0">
        <thead class="table-dark">
            <tr>
                <th>BL</th><th>Consignee</th><th>Navio</th><th>Container</th><th>Tipo</th><th>Tamanho</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var bl in Model)
        {
            if (bl.Containers.Any())
            {
                foreach (var container in bl.Containers)
                {
                    <tr>
                        <td class="fw-semibold">@bl.Numero</td>
                        <td>@bl.Consignee</td>
                        <td>@bl.Navio</td>
                        <td>@container.Numero</td>
                        <td>@container.Tipo</td>
                        <td>@container.Tamanho pés</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="fw-semibold">@bl.Numero</td>
                    <td>@bl.Consignee</td>
                    <td>@bl.Navio</td>
                    <td colspan="3" class="text-muted">Nenhum container vinculado</td>
                </tr>
            }
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">Nenhum BL cadastrado.</td></tr>
        }
        </tbody>
    </table>
</div>
