@model TP02.Models.Bl

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark"><h4>Editar BL</h4></div>
        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Numero" class="form-label">Número do BL</label>
                    <input asp-for="Numero" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Consignee" class="form-label">Consignee</label>
                    <input asp-for="Consignee" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Navio" class="form-label">Navio</label>
                    <input asp-for="Navio" class="form-control" required />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Atualizar</button>
                </div>
            </form>
        </div>
    </div>
</div>
