@model TP02.Models.Container

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Cadastrar Novo Container</h4>
        </div>
        <div class="card-body">
            <form action="/Containers/Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">Número do Container</label>
                    <input type="text" name="Numero" class="form-control" maxlength="11" placeholder="Ex: ABCD1234567" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Tipo</label>
                    <select name="Tipo" class="form-select">
                        <option value="Dry">Dry</option>
                        <option value="Reefer">Reefer</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Tamanho</label>
                    <select name="Tamanho" class="form-select">
                        <option value="20">20 Pés</option>
                        <option value="40">40 Pés</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Vincular ao BL (Obrigatório)</label>
                    <select name="BlId" class="form-select" required>
                        <option value="">-- Selecione o documento BL --</option>
                        @if (TP02.Controllers.BlsController.ListaBls != null)
                        {
                            @foreach (var bl in TP02.Controllers.BlsController.ListaBls)
                            {
                                <option value="@bl.Id">@bl.Numero</option>
                            }
                        }
                    </select>
                </div>


                <div class="d-flex justify-content-between pt-2">
                    <a href="/Containers" class="btn btn-outline-secondary">Voltar</a>
                    <button type="submit" class="btn btn-success">Salvar Container</button>
                </div>
            </form>
        </div>
    </div>
</div>
