@model TP02.Models.Container

<div class="container mt-4" style="max-width: 600px;">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white"><h4>Confirmar Exclusão</h4></div>
        <div class="card-body">
            <h5>Tem certeza que deseja remover este container?</h5>
            <p class="mt-3"><strong>Número:</strong> @Model.Numero</p>
            <p><strong>Tipo:</strong> @Model.Tipo</p>

            <form asp-action="Delete" class="mt-4 d-flex justify-content-between">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger">Remover</button>
            </form>
        </div>
    </div>
</div>

