@{
    ViewData["Title"] = "Página Inicial";
}

<div class="container mt-5 text-center">
    <div class="p-5 mb-4 bg-light rounded-3 border shadow-sm">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-primary"><i class="bi bi-ship"></i> Sistema de Gestão Portuária</h1>
            <p class="col-md-8 fs-4 mx-auto text-muted">Trabalho Prático - Controle e gerenciamento de BLs e seus respectivos Containers.</p>
        </div>
    </div>

    <div class="row justify-content-center g-4 mt-2">
        <!-- Card de BLs -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body d-flex flex-column align-items-center p-4">
                    <h3 class="card-title text-primary mb-3">Gerenciar BLs</h3>
                    <p class="card-text text-muted text-center mb-4">Visualize relatórios, cadastre novos manifestos de carga, edite ou remova registros de BL.</p>
                    <a href="/Bls" class="btn btn-primary btn-lg w-100 mt-auto">Acessar Módulo BL</a>
                </div>
            </div>
        </div>

        <!-- Card de Containers -->
        <div class="col-md-5">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body d-flex flex-column align-items-center p-4">
                    <h3 class="card-title text-success mb-3">Gerenciar Containers</h3>
                    <p class="card-text text-muted text-center mb-4">Controle o inventário de containers (Dry/Reefer), tamanhos e faça o vínculo obrigatório com os BLs.</p>
                    <a href="/Containers" class="btn btn-success btn-lg w-100 mt-auto">Acessar Módulo Containers</a>
                </div>
            </div>
        </div>
    </div>
</div>
